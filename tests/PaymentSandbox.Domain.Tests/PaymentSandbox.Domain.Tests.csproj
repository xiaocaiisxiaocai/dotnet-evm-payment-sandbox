<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- xUnit v3 runs through Microsoft Testing Platform as an executable. -->
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The version is intentionally owned by Directory.Packages.props. -->
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\PaymentSandbox.Domain\PaymentSandbox.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>
</Project>
