<Project>
  <PropertyGroup>
    <!-- Package versions have one review point for the whole solution. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.0" />

    <!-- SIWE recovery needs only the signing package; keep it scoped to Authentication. -->
    <PackageVersion Include="Nethereum.Signer" Version="6.1.0"
                    Condition="'$(MSBuildProjectName)' == 'PaymentSandbox.Authentication' Or
                               '$(MSBuildProjectName)' == 'PaymentSandbox.Authentication.Tests'" />
    <!-- Contract RPC access uses the full Web3 package. Domain remains dependency-free. -->
    <PackageVersion Include="Nethereum.Web3" Version="6.1.0" />
    <!-- Nethereum accepts < 14; pin above its vulnerable 11.0.2 dependency floor. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Used only by the API persistence adapter and its integration tests. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
</Project>
